{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 800,
      "includeFiles": "{*.html,*.css,*.js,*.txt,*.xml,*.ico,*.png,*.apk,manifest.json,.well-known/*.json,assets/*.pdf,assets/*.jpg,assets/*.png,assets/*.css,assets/*.js,assets/*.zip,assets/tour/*.mp4,assets/tour/*.webp}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/broadcast-whatsapp",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/broadcast-whatsapp-priority",
      "schedule": "0 13,19 * * *"
    },
    {
      "path": "/api/cron/saldo-portal",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/crlv-agendado-status",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/pix-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/assinaturas-expirar",
      "schedule": "5 3 * * *"
    }
  ]
}
