{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 800,
      "includeFiles": "{*.html,*.css,*.js,*.txt,*.xml,*.ico,*.png,*.apk,manifest.json,.well-known/*.json,assets/*.pdf,assets/*.jpg,assets/*.png,assets/*.css,assets/*.js}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/broadcast-whatsapp",
      "schedule": "0 11 */3 * *"
    },
    {
      "path": "/api/cron/broadcast-whatsapp-priority",
      "schedule": "40 */3 * * *"
    },
    {
      "path": "/api/cron/broadcast-whatsapp-portal",
      "schedule": "20 13-19/3 * * 1-5"
    },
    {
      "path": "/api/cron/crlv-agendado-status",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/pix-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/atpve-rj-status",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/assinaturas-expirar",
      "schedule": "5 3 * * *"
    }
  ]
}
