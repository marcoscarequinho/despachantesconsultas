{
  "manifest_version": 3,
  "name": "Despachantes Consultas",
  "short_name": "Desp. Consultas",
  "version": "1.0.0",
  "description": "Atalho para o painel da Despachantes Consultas, com o saldo (ou a fatura do pós-pago) sempre à vista.",
  "homepage_url": "https://www.despachantesconsultas.com.br/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Despachantes Consultas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": [
    "https://www.despachantesconsultas.com.br/*"
  ]
}
