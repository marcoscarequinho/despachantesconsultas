{
  "manifest_version": 3,
  "name": "Despachantes Consultas",
  "short_name": "Desp. Consultas",
  "version": "1.1.0",
  "description": "Atalho para o painel da Despachantes Consultas, com o saldo à vista, e agendamento assistido no Detran RJ.",
  "homepage_url": "https://www.despachantesconsultas.com.br/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Despachantes Consultas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.despachantesconsultas.com.br/*",
    "https://www5.detran.rj.gov.br/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www5.detran.rj.gov.br/_agendamento.eletronico/*"],
      "js": ["detran-alerta.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www5.detran.rj.gov.br/_agendamento.eletronico/*"],
      "js": ["detran.js"],
      "run_at": "document_idle"
    }
  ]
}
